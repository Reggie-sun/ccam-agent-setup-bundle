+def _log_request_failure(kind: str, **fields) -> None:
+    """Append one line about a proxied request that did not end in success:
+    when, what kind, status/error code, which account (id prefix), streaming or
+    not. Never request or response content, never credentials. Diagnostics
+    only: any problem writing it is ignored so it can never affect a request."""
+    try:
+        line = json.dumps({"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"), "kind": kind, **fields},
+                          ensure_ascii=False, default=str)
+        path = APP_DIR / "request_failures.jsonl"
+        with _failure_log_lock:
+            if path.exists() and path.stat().st_size > _FAILURE_LOG_MAX_BYTES:
+                path.replace(path.with_suffix(".jsonl.1"))
+            with open(path, "a", encoding="utf-8") as f:
+                f.write(line + "\n")
+    except Exception:  # noqa: BLE001 - diagnostics must never break serving
+        pass
+
