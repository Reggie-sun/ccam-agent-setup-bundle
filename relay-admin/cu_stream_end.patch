+    def _write_proxy_body(self, result):
+        headers = {k.lower(): v for k, v in result.headers.items()}
+        chunks = result.body_chunks
+        if (result.status != 200 or not self.path.partition("?")[0].rstrip("/").endswith("/v1/messages")
+                or "text/event-stream" not in headers.get("content-type", "").lower()):
+            for chunk in chunks:
+                self.wfile.write(chunk)
+            return
+
+        request_id = headers.get("request-id") or headers.get("x-request-id")
+        if not re.fullmatch(r"[a-zA-Z0-9_-]{1,128}", request_id or ""):
+            request_id = None
+        stop_seen = stop_written = stop_event = False
+        line_prefix = b""
+        outcome = "upstream_error"
+        try:
+            for chunk in chunks:
+                # Keep only a bounded line prefix. An SSE event is complete at
+                # the blank line, which can arrive separately from its header.
+                if not stop_seen:
