[Unit]
Description=Private relay account admin UI
After=network.target claude-relay-cu.service
[Service]
User=relay-admin
Group=relay-admin
Environment=ADMIN_ORIGIN=https://admin.example.com
WorkingDirectory=/opt/relay-admin
LoadCredential=admin-auth:/etc/relay-admin/admin-auth
ExecStart=/usr/bin/python3 /opt/relay-admin/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=160M
TasksMax=64
[Install]
WantedBy=multi-user.target
